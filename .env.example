# Supabase — Mode Transaction (Pooler Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase — Mode Session Direct (Pooler Port 5432)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase API Publique
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[VOTRE_CLE_ANON_SUPABASE]"

# Clé secrète pour les sessions JWT administrateur
JWT_SECRET="elevage_secret_jwt_key_ferme_map_2026_super_secure"

# Environnement
NODE_ENV="production"
