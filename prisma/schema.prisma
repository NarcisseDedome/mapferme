// Prisma schema for Elevage Pro

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         String   @default("ADMIN")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model AnimalCategory {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique
  description  String?
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  animals      Animal[]
}

model Animal {
  id          String         @id @default(cuid())
  title       String
  slug        String         @unique
  categoryId  String
  category    AnimalCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description String
  price       Float
  stock       Int            @default(1)
  status      String         @default("DISPONIBLE") // DISPONIBLE, RESERVE, VENDU, EPUISE
  isPublished Boolean        @default(true)
  age         String?
  race        String?
  sex         String?
  weight      String?
  location    String?
  isFeatured  Boolean        @default(false)
  viewsCount  Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      AnimalImage[]
  orderItems  OrderItem[]
}

model AnimalImage {
  id        String   @id @default(cuid())
  animalId  String
  animal    Animal   @relation(fields: [animalId], references: [id], onDelete: Cascade)
  url       String
  isPrimary Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  customerName      String
  customerPhone     String
  customerLocation  String
  deliveryAddress   String?
  notes             String?
  preparationOption String?     @default("VIVANT") // VIVANT, DEPLUME_NETTOYE, DECOUPE_ASSAISONNE, GRILLE
  preparationFee    Float       @default(0)
  totalAmount       Float
  status            String      @default("NOUVELLE") // NOUVELLE, CONFIRMEE, EN_PREPARATION, LIVREE, ANNULEE
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  items             OrderItem[]
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  animalId          String?
  animal            Animal?  @relation(fields: [animalId], references: [id], onDelete: SetNull)
  animalName        String
  unitPrice         Float
  preparationOption String?  @default("VIVANT")
  preparationFee    Float    @default(0)
  quantity          Int
  subtotal          Float
  createdAt         DateTime @default(now())
}

model PortfolioProject {
  id          String    @id @default(cuid())
  title       String
  category    String?
  description String
  imageUrl    String
  eventDate   DateTime?
  isPublished Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Article {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  category    String?
  excerpt     String?
  content     String
  coverImage  String?
  isPublished Boolean  @default(true)
  viewsCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default("default")
  farmName        String   @default("AYEKOBINOU SERVICE")
  tagline         String   @default("Domaine d'élevage & vente de produits — Lapins, Volailles & Cabris")
  aboutText       String   @default("Domaine dédié à l'élevage professionnel et à la vente directe de produits depuis plus de 6 ans. Nous sélectionnons des sujets vigoureux, nourris sainement et suivis rigoureusement sur le plan sanitaire.")
  experienceYears Int      @default(6)
  phone           String   @default("+229 01 66 01 77 83 / +229 01 95 20 43 97")
  whatsappNumber  String   @default("22901660177830")
  email           String   @default("m.aik@hotmail.fr")
  address         String   @default("Domaine AYEKOBINOU SERVICE, Bénin")
  hours           String   @default("Lundi au Samedi : 07h30 - 18h30 | Dimanche sur commande")
  currency        String   @default("FCFA")
  heroTitle       String   @default("Commandez vos grillards si vous désirez gagner du temps dans vos préparations, rapide et bien fait !")
  heroSubtitle    String   @default("Vente directe de lapins de race, poulets fermiers vigoureux et cabris Djallonké élevés au domaine avec soin.")
  heroImage       String?
  facebookUrl     String?  @default("https://facebook.com")
  youtubeUrl      String?
  instagramUrl    String?
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  phoneOrEmail String
  subject      String
  message      String
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}
